# Image source — GitHub Container Registry. Images are built and published by
# each repo's GitHub Actions workflow; the host only ever pulls.
REGISTRY=ghcr.io/borzoihub
BACKEND_TAG=latest
FRONTEND_TAG=latest

# Registry pull credential — FALLBACK ONLY once VOLTINI_HUB_SECRET is set.
# A GitHub classic PAT with `read:packages` ONLY, belonging to a machine user
# (voltini-autobot) that is a member of the org. It grants nothing but reading
# these images.
#
# When VOLTINI_HUB_SECRET is present the update scripts broker a short-lived
# token through central instead and this is never used. Keep it until the
# portal shows a recent "last used" for this Hub — that field exists to answer
# "has this Hub adopted its secret yet?" — then blank it.
GHCR_USER=voltini-autobot
GHCR_TOKEN=

# ── Hub credential broker ───────────────────────────────────────────────────
# The ONE credential this Hub holds for central. It is exchanged on demand for
# short-lived cloud credentials, so no AWS key and no long-lived registry token
# has to live on this SD card. Spec:
#   voltini.energy-backend/docs/HUB_CREDENTIAL_BROKER.md
#
# Issue it in the installer portal (Installation → Hub secret) and paste it
# here. It is shown ONCE; if you lose it, issue a new one — rotation takes
# effect immediately and invalidates the previous value.
#
# Used by the deploy/infra layer ONLY. borzoi-backend must never read it: the
# architecture invariant permits this credential precisely because it stays out
# of application code, and a CI check over borzoi-backend/src enforces that.
VOLTINI_HUB_SECRET=
VOLTINI_BROKER_URL=https://api.voltini.energy/api/hub/credentials

# This Hub's installation id in central — also the S3 key prefix its brokered
# credentials are confined to. Must match, or every upload gets AccessDenied.
VOLTINI_INSTALLATION_ID=

# Cloud backup (theworks-db-backup). Off unless you add `cloud-backup` to
# COMPOSE_PROFILES — a Hub without a central secret keeps using the local-only
# scripts/db-backup.sh instead.
#   COMPOSE_PROFILES=cloud-backup
COMPOSE_PROFILES=
BACKUP_S3_BUCKET=
BACKUP_AWS_REGION=eu-north-1
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=14

# OTA updater sidecar (set by setup.sh). Absolute host path — the updater
# mounts the project at its real path so compose's relative bind mounts
# resolve identically inside and outside the container.
#   INSTALL_DIR = this bundle's directory (output of `pwd`)
INSTALL_DIR=

# Public URL / domain
# The stack binds to http://localhost:8080 on the host. Public access is
# expected via Cloudflare Tunnel (or another reverse proxy). Change these
# two to the real public URL only when email features are active — the
# values end up as links inside outbound mail (password reset, etc.).
BORZOI_DOMAIN=localhost
BORZOI_BASE_URL=http://localhost:8080

# Database (auto-generated by setup.sh — do not edit after first boot;
# postgres only reads POSTGRES_PASSWORD on initial cluster init)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=borzoi
DB_USER=borzoi
DB_PASSWORD=

# Auth (auto-generated)
JWT_SECRET=

# Bootstrap admin (auto-generated; created on first boot only)
BORZOI_ADMIN_EMAIL=
BORZOI_ADMIN_PASSWORD=

# NO application AWS credentials — deliberately (2026-07-31).
#
# BORZOI_AWS_REGION / BORZOI_AWS_ACCESS_KEY_ID / BORZOI_AWS_SECRET_ACCESS_KEY /
# S3_BUCKET / SES_SENDER lived here, holding "AKIA-unused-placeholder" and
# friends. They existed only to satisfy the backend entrypoint's env-var gate;
# the S3/SES code behind them was dead and has been removed. A Hub holds no
# long-lived AWS credential of any kind.
#
# The nightly backup — the one thing here that really does talk to AWS — uses
# VOLTINI_HUB_SECRET above to fetch short-lived STS credentials from central,
# scoped to this installation's own S3 prefix. See the db-backup service in
# docker-compose.yml.
#
# If you are upgrading an existing Hub, you may leave the five stale lines in
# your .env: they are ignored, and no host needs hand-editing to boot.

# Self-hosted / embedded mode: allow typeorm synchronize in Production.
# Required for fresh installs without an initial-schema migration.
# Regular SaaS deployments DO NOT set this.
BORZOI_ALLOW_SYNC_IN_PROD=true
