REGISTRY=ghcr.io/borzoihub

# Shared read:packages pull token; required (docs/architecture.md)
GHCR_USER=voltini-autobot
GHCR_TOKEN=

# Connection key from the installer portal: installation → Nyckel
VOLTINI_HUB_SECRET=
VOLTINI_BROKER_URL=https://api.voltini.energy/api/hub/credentials

# Must match the installation id in the connection key
VOLTINI_INSTALLATION_ID=

# Set to cloud-backup to enable the nightly cloud backup
COMPOSE_PROFILES=

# Absolute path of this bundle's directory (set by setup.sh)
INSTALL_DIR=

BORZOI_DOMAIN=localhost
BORZOI_BASE_URL=http://localhost:8080

# Auto-generated by setup.sh; do not change after first boot
DB_HOST=postgres
DB_PORT=5432
DB_NAME=borzoi
DB_USER=borzoi
DB_PASSWORD=

# Auto-generated by setup.sh
JWT_SECRET=

# Auto-generated by setup.sh; the admin is created on first boot only
BORZOI_ADMIN_EMAIL=
BORZOI_ADMIN_PASSWORD=

# Optional, set by hand: public Mapbox token for the map in the Hub UI
MAPBOX_TOKEN=
